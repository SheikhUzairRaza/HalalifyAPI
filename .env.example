PORT=5000
NODE_ENV=development

# Database Configuration (MySQL / Laragon)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=halalfy_db
# DB_PASSWORD='Awmu@1234'
# JWT Token Configuration
ACCESS_TOKEN_SECRET=your_access_token_secret_key_12345
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_SECRET=your_refresh_token_secret_key_67890
REFRESH_TOKEN_EXPIRY=7d

# Firebase Admin SDK Configuration (for Google OAuth)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgk...\n-----END PRIVATE KEY-----\n"

# Finnhub API Configuration (Stock Market Data Ingestion)
FINNHUB_API_KEY=your_finnhub_api_key_here
